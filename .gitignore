# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
build/
dist/
*.egg-info/

# Node
node_modules/
app/dist/
# pnpm writes its content-addressed cache here when the store is set to the repo.
# It is a build cache, not source.
.pnpm-store/

# Rust
target/

# Tauri sidecar payload, produced by `just build-sidecar`. The directory itself is
# kept, because tauri-build refuses to build at all when a path in `bundle.resources`
# is missing, and that stopped `cargo clippy` on a fresh clone.
app/src-tauri/binaries/*
!app/src-tauri/binaries/engine/
app/src-tauri/binaries/engine/*
!app/src-tauri/binaries/engine/.gitkeep

# Local state
.DS_Store
.env
