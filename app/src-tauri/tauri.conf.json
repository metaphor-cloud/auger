{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Auger",
  "version": "0.2.3",
  "identifier": "cloud.metaphor.auger",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "Auger",
        "width": 1000,
        "height": 700,
        "visible": false,
        "resizable": true,
        "backgroundColor": "#0b0f14"
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:* ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/engine": "engine"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "entitlements": "entitlements.plist"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDcwRDZBQjZFNDRCMTA3RjIKUldUeUI3RkVicXZXY0ZKeXREVndLeFJNM0RKWDNmRjhGMnh6dHJ3elU3T1JLS0U3V2h4TVcrNHcK",
      "endpoints": [
        "https://github.com/metaphor-cloud/auger/releases/latest/download/latest.json"
      ]
    }
  }
}
